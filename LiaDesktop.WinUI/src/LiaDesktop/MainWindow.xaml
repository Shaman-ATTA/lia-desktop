<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiaDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:render="using:LiaDesktop.Rendering"
    Title="Lia · ATTA CORP">

  <Grid x:Name="Root" Background="#FF05070C">
    <!-- Full-bleed hologram stage (no boxed frame) -->
    <render:HoloPanel x:Name="Holo" Margin="0,36,0,96"/>

    <!-- Soft vignette so glass cards read over the head -->
    <Grid IsHitTestVisible="False" Margin="0,36,0,96">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.22*"/>
        <ColumnDefinition Width="0.56*"/>
        <ColumnDefinition Width="0.22*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#CC05070C" Offset="0"/>
            <GradientStop Color="#0005070C" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Grid.Column="2">
        <Border.Background>
          <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
            <GradientStop Color="#CC05070C" Offset="0"/>
            <GradientStop Color="#0005070C" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <!-- 2D cinematic HUD arcs / ticks / scan (drawn in code) -->
    <Canvas x:Name="HudCanvas" IsHitTestVisible="False" Margin="0,36,0,96"/>

    <!-- Custom title bar -->
    <Border x:Name="AppTitleBar" VerticalAlignment="Top" Height="36" Background="#9905070C"
            BorderBrush="#33FF9A3C" BorderThickness="0,0,0,1" Padding="18,0,160,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
          <TextBlock Text="ЛИА" Foreground="{StaticResource LiaAmber}" FontFamily="{StaticResource LiaUi}"
                     FontSize="13" FontWeight="SemiBold" CharacterSpacing="200"/>
          <TextBlock Text="//" Foreground="{StaticResource LiaMuted}" FontFamily="{StaticResource LiaMono}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock Text="ATTA · N-33" Foreground="{StaticResource LiaMuted}" FontFamily="{StaticResource LiaMono}" FontSize="11" VerticalAlignment="Center"/>
          <TextBlock x:Name="GreetingLine" Text="Доброй ночи, сэр." Foreground="{StaticResource LiaCyanDim}"
                     FontFamily="{StaticResource LiaUi}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Margin="0,0,8,0">
          <TextBlock x:Name="SysLine" Style="{StaticResource HudMono}" FontSize="10" VerticalAlignment="Center"/>
          <Button Content="CONFIG" Click="Settings_Click" Style="{StaticResource HudGhostButton}" Padding="10,3"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Floating glass: status + journal -->
    <Border x:Name="LeftCard" Width="236" HorizontalAlignment="Left" VerticalAlignment="Stretch"
            Margin="18,56,0,120" Background="{StaticResource LiaPanel}"
            BorderBrush="{StaticResource LiaHairline}" BorderThickness="1" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Corner brackets -->
        <Canvas IsHitTestVisible="False" Grid.RowSpan="3" Margin="-14">
          <Path Stroke="{StaticResource LiaAmber}" StrokeThickness="1.2" Data="M 0,18 L 0,0 L 18,0"/>
          <Path Stroke="{StaticResource LiaAmber}" StrokeThickness="1.2" Data="M 218,0 L 236,0 L 236,18" Canvas.Left="0"/>
          <Path x:Name="LeftBracketBL" Stroke="{StaticResource LiaAmber}" StrokeThickness="1.2"/>
          <Path x:Name="LeftBracketBR" Stroke="{StaticResource LiaAmber}" StrokeThickness="1.2"/>
        </Canvas>
        <StackPanel Spacing="8">
          <TextBlock Text="TELEMETRY" Style="{StaticResource HudLabel}"/>
          <TextBlock x:Name="VoiceLine" Style="{StaticResource HudMono}"/>
          <TextBlock x:Name="ModelLine" Style="{StaticResource HudMono}"/>
          <TextBlock Text="MESH   HOLO · DX11" Style="{StaticResource HudMono}"/>
          <TextBlock x:Name="LinkLine" Text="LINK   OK · 12ms" Style="{StaticResource HudMono}"/>
          <TextBlock x:Name="CpuLine" Style="{StaticResource HudMono}"/>
          <TextBlock x:Name="RamLine" Style="{StaticResource HudMono}"/>
          <TextBlock x:Name="NetLine" Style="{StaticResource HudMono}"/>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="{StaticResource LiaHairline}" Margin="0,14,0,10"/>
        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="JOURNAL" Style="{StaticResource HudLabel}"/>
          <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LogPanel" Spacing="5"/>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <!-- Floating glass: dialog + system -->
    <Border x:Name="RightCard" Width="252" HorizontalAlignment="Right" VerticalAlignment="Stretch"
            Margin="0,56,18,120" Background="{StaticResource LiaPanel}"
            BorderBrush="{StaticResource LiaHairline}" BorderThickness="1" Padding="14">
      <StackPanel Spacing="10">
        <Canvas IsHitTestVisible="False" Height="0">
          <Path Stroke="{StaticResource LiaCyan}" StrokeThickness="1.2" Data="M 0,18 L 0,0 L 18,0"/>
        </Canvas>
        <TextBlock Text="UPLINK" Style="{StaticResource HudLabel}"/>
        <TextBlock Text="Команда или голос" Foreground="{StaticResource LiaMuted}"
                   FontFamily="{StaticResource LiaUi}" FontSize="11"/>
        <TextBox x:Name="CommandBox" PlaceholderText="›" Style="{StaticResource HudLineInput}"
                 AcceptsReturn="False" KeyDown="CommandBox_KeyDown"/>
        <Button Content="TRANSMIT" Click="Send_Click" Style="{StaticResource HudGhostButton}"
                HorizontalAlignment="Stretch"/>
        <Border Height="1" Background="{StaticResource LiaHairline}" Margin="0,6,0,2"/>
        <TextBlock Text="SYSTEM" Style="{StaticResource HudLabel}"/>
        <TextBlock x:Name="SysPanel" Style="{StaticResource HudMono}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Center subtitle strip (no box frame) -->
    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,118"
                IsHitTestVisible="False" Spacing="4">
      <TextBlock x:Name="StatusCaption" Text="STANDBY" Foreground="{StaticResource LiaAmber}"
                 FontFamily="{StaticResource LiaUi}" FontSize="14" CharacterSpacing="180"
                 HorizontalAlignment="Center"/>
      <TextBlock x:Name="Subtitle" Text="Скажите «Лиа» или нажмите микрофон"
                 Foreground="{StaticResource LiaCyan}" Opacity="0.92"
                 FontFamily="{StaticResource LiaUi}" FontSize="13"
                 HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                 TextAlignment="Center"/>
    </StackPanel>

    <!-- Bottom dock: tabs + glowing mic orb -->
    <Border VerticalAlignment="Bottom" Height="96" Background="#E005070C"
            BorderBrush="#22FF9A3C" BorderThickness="0,1,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="36">
          <TextBlock Text="HOME" Style="{StaticResource HudTab}" Foreground="{StaticResource LiaAmber}"/>
          <Grid Width="88" Height="88">
            <!-- Soft glow -->
            <Ellipse Width="78" Height="78" Opacity="0.22">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#FFFF9A3C" Offset="0"/>
                  <GradientStop Color="#00FF9A3C" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Canvas x:Name="WaveCanvas" Width="88" Height="88" IsHitTestVisible="False"/>
            <Button x:Name="MicBtn" Width="56" Height="56" CornerRadius="28"
                    Click="Mic_Click" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Padding="0">
              <Grid Width="52" Height="52">
                <Ellipse x:Name="MicGlow" Width="52" Height="52" Opacity="0.55">
                  <Ellipse.Fill>
                    <RadialGradientBrush>
                      <GradientStop Color="#FFFFB060" Offset="0"/>
                      <GradientStop Color="#AAFF6A20" Offset="0.55"/>
                      <GradientStop Color="#33FF9A3C" Offset="1"/>
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="40" Height="40" Stroke="{StaticResource LiaAmber}" StrokeThickness="1.4"
                         Fill="#CC120E14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="MicGlyph" Text="◉" Foreground="{StaticResource LiaAmber}"
                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </Grid>
          <TextBlock Text="AGENT" Style="{StaticResource HudTab}"/>
        </StackPanel>
        <TextBlock Text="Ctrl+Alt+S · abort" Foreground="{StaticResource LiaMuted}" FontSize="10"
                   FontFamily="{StaticResource LiaMono}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
      </Grid>
    </Border>

    <!-- Boot veil -->
    <Grid x:Name="BootOverlay" Background="#FF05070C">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="ЛИА" Foreground="{StaticResource LiaAmber}" FontFamily="{StaticResource LiaUi}"
                   FontSize="42" CharacterSpacing="320" HorizontalAlignment="Center" FontWeight="SemiBold"/>
        <TextBlock x:Name="BootStatus" Text="INITIALIZING HOLOMESH…" Foreground="{StaticResource LiaCyan}"
                   FontFamily="{StaticResource LiaMono}" FontSize="12" HorizontalAlignment="Center" CharacterSpacing="40"/>
        <ProgressBar x:Name="BootBar" Width="220" Height="2" IsIndeterminate="True"
                     Foreground="{StaticResource LiaAmber}" Background="#22FF9A3C"/>
      </StackPanel>
    </Grid>

    <!-- Settings glass -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#CC05070C">
      <Border Width="460" Padding="22" Background="{StaticResource LiaPanelSolid}"
              BorderBrush="{StaticResource LiaAmber}" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="CONFIG · LIA" Foreground="{StaticResource LiaAmber}"
                     FontFamily="{StaticResource LiaUi}" FontSize="16" CharacterSpacing="80"/>
          <TextBlock Text="Ключ Gemini (aistudio.google.com/apikey). Модель — ListModels."
                     Foreground="{StaticResource LiaMuted}" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="PROVIDER" Style="{StaticResource HudLabel}"/>
          <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="gemini" IsSelected="True"/>
            <ComboBoxItem Content="ollama"/>
          </ComboBox>
          <TextBlock Text="API KEY" Style="{StaticResource HudLabel}"/>
          <PasswordBox x:Name="ApiKeyBox"/>
          <TextBlock Text="MODEL" Style="{StaticResource HudLabel}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModelBox" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Content="REFRESH" Margin="8,0,0,0" Click="RefreshModels_Click"
                    Style="{StaticResource HudGhostButton}"/>
          </Grid>
          <TextBlock x:Name="ModelsHint" Foreground="{StaticResource LiaMuted}" FontSize="11"/>
          <TextBlock Text="WORKSPACE" Style="{StaticResource HudLabel}"/>
          <TextBox x:Name="WorkspaceBox" Style="{StaticResource HudLineInput}"/>
          <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows (в трее, ждать «Лиа»)"
                    Foreground="{StaticResource LiaMuted}" Margin="0,8,0,0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="CANCEL" Click="SettingsCancel_Click" Style="{StaticResource HudGhostButton}"/>
            <Button Content="SAVE" Click="SettingsSave_Click" Style="{StaticResource HudGhostButton}"
                    BorderBrush="{StaticResource LiaAmber}" Foreground="{StaticResource LiaAmber}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
