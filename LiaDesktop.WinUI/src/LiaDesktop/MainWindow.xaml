<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LiaDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:render="using:LiaDesktop.Rendering"
    Title="Lia Assistant · ATTA CORP">

  <Grid x:Name="Root" Background="{StaticResource LiaBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="72"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border Grid.Row="0" BorderBrush="{StaticResource LiaAmber}" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="ЛИА · ATTA CORP · N-33" Foreground="{StaticResource LiaAmber}" FontWeight="SemiBold" FontSize="14" CharacterSpacing="40"/>
          <TextBlock Text="Доброй ночи, сэр." Foreground="{StaticResource LiaMuted}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="16">
          <TextBlock x:Name="SysLine" Foreground="{StaticResource LiaCyan}" FontSize="11" FontFamily="Consolas"/>
          <Button Content="НАСТРОЙКИ" Click="Settings_Click" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Padding="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <!-- Status / Journal -->
      <StackPanel Grid.Column="0" Spacing="10">
        <Border Background="{StaticResource LiaPanel}" BorderBrush="{StaticResource LiaAmber}" BorderThickness="1" Padding="12" CornerRadius="2">
          <StackPanel Spacing="6">
            <TextBlock Text="СТАТУС" Foreground="{StaticResource LiaAmber}" FontSize="11" CharacterSpacing="80"/>
            <TextBlock x:Name="VoiceLine" Foreground="{StaticResource LiaCyan}" FontFamily="Consolas" FontSize="12"/>
            <TextBlock x:Name="ModelLine" Foreground="{StaticResource LiaCyan}" FontFamily="Consolas" FontSize="12"/>
            <TextBlock Text="MESH  HOLO · DX11" Foreground="{StaticResource LiaCyan}" FontFamily="Consolas" FontSize="12"/>
            <TextBlock Text="LINK  OK" Foreground="{StaticResource LiaCyan}" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource LiaPanel}" BorderBrush="{StaticResource LiaAmber}" BorderThickness="1" Padding="12" CornerRadius="2" Height="360">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="ЖУРНАЛ" Foreground="{StaticResource LiaAmber}" FontSize="11" CharacterSpacing="80"/>
            <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
              <StackPanel x:Name="LogPanel" Spacing="4"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Hologram stage -->
      <Border Grid.Column="1" Margin="10,0" BorderBrush="{StaticResource LiaAmber}" BorderThickness="1" Background="#08050F">
        <Grid>
          <render:HoloPanel x:Name="Holo"/>
          <TextBlock x:Name="StatusCaption" Text="ОЖИДАНИЕ" Foreground="{StaticResource LiaAmber}"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,36"
                     FontSize="14" CharacterSpacing="120"/>
          <TextBlock x:Name="Subtitle" Text="Скажите «Лиа» или нажмите микрофон"
                     Foreground="{StaticResource LiaCyan}" Opacity="0.85"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" FontSize="12"/>
        </Grid>
      </Border>

      <!-- Dialog -->
      <Border Grid.Column="2" Background="{StaticResource LiaPanel}" BorderBrush="{StaticResource LiaAmber}" BorderThickness="1" Padding="12" CornerRadius="2">
        <StackPanel Spacing="10">
          <TextBlock Text="ДИАЛОГ" Foreground="{StaticResource LiaAmber}" FontSize="11" CharacterSpacing="80"/>
          <TextBlock Text="Скажите задачу или нажмите микрофон…" Foreground="{StaticResource LiaMuted}" TextWrapping="Wrap" FontSize="12"/>
          <TextBox x:Name="CommandBox" PlaceholderText="Команда…" AcceptsReturn="False" KeyDown="CommandBox_KeyDown"/>
          <Button Content="Отправить" Click="Send_Click" HorizontalAlignment="Stretch"/>
          <TextBlock Text="СИСТЕМА" Foreground="{StaticResource LiaAmber}" FontSize="11" CharacterSpacing="80" Margin="0,16,0,0"/>
          <TextBlock x:Name="SysPanel" Foreground="{StaticResource LiaCyan}" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bottom nav / mic -->
    <Border Grid.Row="2" BorderBrush="{StaticResource LiaAmber}" BorderThickness="0,1,0,0" Background="#E00A0714">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
          <TextBlock Text="Главная" Foreground="{StaticResource LiaAmber}" VerticalAlignment="Center"/>
          <Button x:Name="MicBtn" Width="64" Height="64" CornerRadius="32" Click="Mic_Click"
                  Background="{StaticResource LiaAmber}" Foreground="Black" FontSize="22" Content="🎤"/>
          <TextBlock Text="Агент" Foreground="{StaticResource LiaMuted}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Ctrl+Alt+S · стоп" Foreground="{StaticResource LiaMuted}" FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
      </Grid>
    </Border>

    <!-- Settings overlay -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#CC000000" Grid.RowSpan="3">
      <Border Width="440" Padding="20" Background="#FF120E1C" BorderBrush="{StaticResource LiaAmber}" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Настройки · Лиа" Foreground="{StaticResource LiaAmber}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Ключ Gemini (aistudio.google.com/apikey). Модель — ListModels." Foreground="{StaticResource LiaMuted}" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="Провайдер" Foreground="{StaticResource LiaMuted}" FontSize="11"/>
          <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="gemini" IsSelected="True"/>
            <ComboBoxItem Content="ollama"/>
          </ComboBox>
          <TextBlock Text="API key" Foreground="{StaticResource LiaMuted}" FontSize="11"/>
          <PasswordBox x:Name="ApiKeyBox"/>
          <TextBlock Text="Модель" Foreground="{StaticResource LiaMuted}" FontSize="11"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModelBox" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Content="Обновить" Margin="8,0,0,0" Click="RefreshModels_Click"/>
          </Grid>
          <TextBlock x:Name="ModelsHint" Foreground="{StaticResource LiaMuted}" FontSize="11"/>
          <TextBlock Text="Workspace" Foreground="{StaticResource LiaMuted}" FontSize="11"/>
          <TextBox x:Name="WorkspaceBox"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Отмена" Click="SettingsCancel_Click"/>
            <Button Content="Сохранить" Click="SettingsSave_Click" Style="{StaticResource AccentButtonStyle}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
