<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LiaDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="LiaAmber" Color="#FF9A3C"/>
      <SolidColorBrush x:Key="LiaCyan" Color="#5AD6FF"/>
      <SolidColorBrush x:Key="LiaBg" Color="#0A0714"/>
      <SolidColorBrush x:Key="LiaPanel" Color="#CC120E1C"/>
      <SolidColorBrush x:Key="LiaMuted" Color="#88A0A8B8"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
